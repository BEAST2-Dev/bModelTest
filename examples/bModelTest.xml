<?xml version="1.0" encoding="UTF-8" standalone="no"?><beast beautitemplate='Standard' beautistatus='' namespace="beast.base.spec.inference.parameter:beast.base.spec.domain:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.evolution.alignment:beast.base.evolution.tree.coalescent:beast.pkgmgmt:beast.base.core:beast.base.inference.util:beast.evolution.nuc:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood" version="2.8">


    <data
id="dna"
name="alignment">
                    <sequence id="seq_Cow" taxon="Cow" totalcount="4" value="---------------------TAA"/>
                    <sequence id="seq_Carp" taxon="Carp" totalcount="4" value=""/>
                    <sequence id="seq_Chicken" taxon="Chicken" totalcount="4" value="ATGGCCAACCACTCCCAACTAGGCTTTCAAGACGCCTCATCCCCCATCATAGAAGAGCTCGTTGAATTCCACGACCACGCCCTGATAGTCGCACTAGCAATTTGCAGCTTAGTACTCTACCTTCTAACTCTTATACTTATAGAAAAACTATCA---------------------CTGTCATCTTAA"/>
                    <sequence id="seq_Human" taxon="Human" totalcount="4" value="---------------------GGGCCCGTATTTACCCTATAG"/>
                    <sequence id="seq_Loach" taxon="Loach" totalcount="4" value=""/>
                    <sequence id="seq_Mouse" taxon="Mouse" totalcount="4" value="---------------------TAA"/>
                    <sequence id="seq_Rat" taxon="Rat" totalcount="4" value="---------------------TAA"/>
                    <sequence id="seq_Seal" taxon="Seal" totalcount="4" value="---------------------TAA"/>
                    <sequence id="seq_Whale" taxon="Whale" totalcount="4" value="---------------------TAA"/>
                    <sequence id="seq_Frog" taxon="Frog" totalcount="4" value="---GAAGCATCACTA------AGA"/>
                </data>


    


    




<run id="mcmc" spec="beast.base.inference.MCMC" chainLength="10000000">
    <state id="state" storeEvery="5000">
        <tree id="Tree.t:dna" name="stateNode">
            <taxonset id="TaxonSet.dna" spec="TaxonSet">
                <alignment idref="dna"/>
            </taxonset>
        </tree>
        <stateNode id="birthRate.t:dna" spec="RealScalarParam" domain="PositiveReal">1.0</stateNode>
        <stateNode id="BMTmodelIndicator.s:dna" spec="IntScalarParam" domain="NonNegativeInt">0</stateNode>
        <stateNode id="BMTrates.s:dna" spec="RealVectorParam" domain="NonNegativeReal" dimension="6" name="stateNode">1.0</stateNode>
        <stateNode id="gammaShape.s:dna" spec="RealScalarParam" domain="PositiveReal" name="stateNode">1.0</stateNode>
        <stateNode id="proportionInvariant.s:dna" spec="RealScalarParam" domain="UnitInterval" name="stateNode">0.1</stateNode>

        <stateNode id="hasInvariantSites.s:dna" spec="IntScalarParam" domain="NonNegativeInt">1</stateNode>
        <stateNode id="hasGammaRates.s:dna" spec="IntScalarParam" domain="NonNegativeInt">1</stateNode>
        <!-- frequencies estimation -->
        <stateNode id="hasEqualFreqs.s:dna" spec="BoolScalarParam">false</stateNode>
        <stateNode id="frequencies.s:dna" spec="SimplexParam">0.25 0.25 0.25 0.25</stateNode>
    </state>

    <init id="RandomTree.t:dna" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:dna" taxa="@dna">
        <populationModel id="ConstantPopulation0.t:dna" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
            <popSize spec="RealScalarParam" domain="PositiveReal">1.0</popSize>
        </populationModel>
    </init>

    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">
        <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
            <distribution id="YuleModel.t:dna" spec="beast.base.spec.evolution.speciation.YuleModel" birthDiffRate="@birthRate.t:dna" tree="@Tree.t:dna"/>

            <distribution id="BMTprior.s:dna" spec="bmodeltest.math.distributions.NucleotideRevJumpSubstModelRatePrior"
                priorType="onTransitionsAndTraversals"
                modelIndicator="@BMTmodelIndicator.s:dna" x="@BMTrates.s:dna" substModel="@RevJump.s:dna"/>
            <!-- Yule birth rate: implicit improper uniform on (0, ∞); no explicit prior needed in 2.8. -->

            <distribution id="BMTPropInvariantPrior.s:dna" spec="bmodeltest.math.distributions.BMTPrior" x="@proportionInvariant.s:dna" count='@hasInvariantSites.s:dna'>
                <distr id="Uniform.01" spec="beast.base.spec.inference.distribution.Uniform">
                    <lower spec="RealScalarParam" domain="Real">0.0</lower>
                    <upper spec="RealScalarParam" domain="Real">1.0</upper>
                </distr>
            </distribution>

            <distribution id="BMTGammaShapePrior.s:dna" spec="bmodeltest.math.distributions.BMTPrior" x="@gammaShape.s:dna" count='@hasGammaRates.s:dna'>
                <distr id="Exponential.0" spec="beast.base.spec.inference.distribution.Exponential">
                    <mean spec="RealScalarParam" domain="PositiveReal">1.0</mean>
                </distr>
            </distribution>
            
            <!-- frequencies estimation -->
            <distribution id="freqsPrior.s:dna" spec="beast.base.spec.inference.distribution.Dirichlet" param="@frequencies.s:dna">
                <alpha spec="RealVectorParam" domain="PositiveReal" dimension="4">1.0</alpha>
            </distribution>

        </distribution>
        <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution">
            <distribution id="treeLikelihood.dna" spec="beast.base.spec.evolution.likelihood.TreeLikelihood" data="@dna" tree="@Tree.t:dna">
                <siteModel id="SiteModel.s:dna" spec="bmodeltest.evolution.sitemodel.BEASTModelTestSiteModel"
                	gammaCategoryCount="4" proportionInvariant="@proportionInvariant.s:dna" shape="@gammaShape.s:dna"
                	hasGammaRates="@hasGammaRates.s:dna" hasInvariantSites="@hasInvariantSites.s:dna">
                    <parameter id="mutationRate.s:dna" spec="RealScalarParam" domain="PositiveReal" estimate="false" name="mutationRate">1.0</parameter>
                    <substModel id="RevJump.s:dna" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" 
                        modelIndicator="@BMTmodelIndicator.s:dna" rates="@BMTrates.s:dna"
                        modelSet="transitionTransversionSplit">
                        
                        <!-- frequencies estimation -->
                        <!-- case where we switch between empirical and equal frequencies
                        <frequencies id="freqs.s:dna" spec="ModelFrequencies" data="@dna" hasEqualFreqs='@hasEqualFreqs.s:dna' emprical="true"/>
                        -->
                        <!-- case where we switch between empirical and estimated frequencies -->
                        <frequencies id="freqs.s:dna" spec="bmodeltest.evolution.substitutionmodel.ModelFrequencies" frequencies="@frequencies.s:dna" hasEqualFreqs='@hasEqualFreqs.s:dna' empirical="false"/>
                        
                    </substModel>
                </siteModel>
                <branchRateModel id="StrictClock.c:dna" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                    <clock.rate spec="RealScalarParam" domain="PositiveReal" estimate="false">1.0</clock.rate>
                </branchRateModel>
            </distribution>
        </distribution>
    </distribution>

    <operator id="YuleBirthRateScaler.t:dna" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@birthRate.t:dna" scaleFactor="0.75" weight="3.0"/>

    <operator id="treeScaler.t:dna" spec="ScaleOperator" scaleFactor="0.5" tree="@Tree.t:dna" weight="3.0"/>

    <operator id="treeRootScaler.t:dna" spec="ScaleOperator" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:dna" weight="3.0"/>

    <operator id="UniformOperator.t:dna" spec="Uniform" tree="@Tree.t:dna" weight="30.0"/>

    <operator id="SubtreeSlide.t:dna" spec="SubtreeSlide" tree="@Tree.t:dna" weight="15.0"/>

    <operator id="narrow.t:dna" spec="Exchange" tree="@Tree.t:dna" weight="15.0"/>

    <operator id="wide.t:dna" spec="Exchange" isNarrow="false" tree="@Tree.t:dna" weight="3.0"/>

    <operator id="WilsonBalding.t:dna" spec="WilsonBalding" tree="@Tree.t:dna" weight="3.0"/>

    <operator id="BMTOperator.s:dna" spec="bmodeltest.evolution.operators.BMTMergeSplitOperator" modelIndicator="@BMTmodelIndicator.s:dna" rates="@BMTrates.s:dna" substModel="@RevJump.s:dna" weight="1.0"/>
    <operator id="BMTexchanger.s:dna" spec="bmodeltest.evolution.operators.BMTExchangeOperator" modelIndicator="@BMTmodelIndicator.s:dna" rates="@BMTrates.s:dna" substModel="@RevJump.s:dna"  delta="0.1" weight="1.0"/>

    <operator id="BMTshapeOperator.s:dna" spec="bmodeltest.evolution.operators.BMTBirthDeathOperator" count="@hasGammaRates.s:dna" rates="@gammaShape.s:dna" weight="1.0"/>
    <operator id="BMTshapecaler.s:dna" spec="bmodeltest.evolution.operators.BMTScaleOperator" count="@hasGammaRates.s:dna" parameter="@gammaShape.s:dna" scaleFactor="0.5" weight="1.0"/>

    <operator id="BMTpinvOperator.s:dna" spec="bmodeltest.evolution.operators.BMTBirthDeathOperator" count="@hasInvariantSites.s:dna" rates="@proportionInvariant.s:dna" weight="1.0"/>
    <operator id="BMTpInvscaler.s:dna" spec="bmodeltest.evolution.operators.BMTScaleOperator" count="@hasInvariantSites.s:dna" parameter="@proportionInvariant.s:dna" scaleFactor="0.5" weight="1.0"/>
   
    <!-- frequencies estimation -->
    <operator id="BMTFreqsFlipOperator.s:dna" spec="beast.base.spec.inference.operator.BitFlipOperator" parameter="@hasEqualFreqs.s:dna" weight="0.1"/>
    <operator id='FrequenciesExchanger.s:dna' spec='beast.base.spec.inference.operator.DeltaExchangeOperator' delta="0.01" weight="0.1" rvparameter="@frequencies.s:dna"/>
    
    
    <logger id="tracelog" fileName="dna.log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
        <log idref="posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
        <log idref="treeLikelihood.dna"/>
        <log id="TreeHeight.t:dna" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:dna"/>
        <log idref="YuleModel.t:dna"/>
        <log idref="birthRate.t:dna"/>
        <log idref="BMTmodelIndicator.s:dna"/>
		<log idref="RevJump.s:dna"/>
        <log idref="BMTrates.s:dna"/>
        <log idref="gammaShape.s:dna"/>
        
        <log id="ActivePropInvariant" spec='beast.base.spec.inference.util.RPNcalculator' expression="proportionInvariant.s:dna hasInvariantSites.s:dna *">
	        <parameter idref="proportionInvariant.s:dna"/>
	        <parameter idref="hasInvariantSites.s:dna"/>
        </log>
        <log id="ActiveGammaShape" spec='beast.base.spec.inference.util.RPNcalculator' expression="gammaShape.s:dna hasGammaRates.s:dna *">
	        <parameter idref="gammaShape.s:dna"/>
	        <parameter idref="hasGammaRates.s:dna"/>
        </log>
        <log idref="proportionInvariant.s:dna"/>
        
        <!-- frequencies estimation -->
    	<log idref="hasEqualFreqs.s:dna"/>
    	<log idref="frequencies.s:dna"/>

        <log idref='hasGammaRates.s:dna'/>
        <log idref='hasInvariantSites.s:dna'/>
        
    	<log idref="BMTGammaShapePrior.s:dna"/>
    	<log idref="BMTPropInvariantPrior.s:dna" />
    	
    </logger>

    <logger id="screenlog" logEvery="1000">
        <log idref="posterior"/>
        <log id="ESS.0" spec="util.ESS" arg="@posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
    </logger>

    <logger id="treelog.t:dna" fileName="dna.trees" logEvery="1000" mode="tree">
        <log id="TreeWithMetaDataLogger.t:dna" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:dna"/>
    </logger>

</run>

</beast>
